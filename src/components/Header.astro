// Top bar: logo · GitHub · theme.
import { githubMark } from "../lib/code";
import { site } from "../site.config";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<!-- marks the top of the page: the bar gets its hairline once this scrolls
     away (script below) -->
<div class="top-sentinel" aria-hidden="true"></div>
<header class="site-header">
  <div class="wrap bar">
    <a href={site.links.home} class="brand" aria-label={site.ui.homeLabel}>
      <Logo height={26} />
    </a>

    <div class="tools">
      {/* biome-ignore lint/a11y/useAnchorContent: aria-label names the link, the icon is hidden */}
      <a href={site.links.github} class="icon-button" aria-label={site.ui.githubLabel}>
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d={githubMark} />
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
// At the top of the page the bar has no border, so it reads as part of the
// browser's own toolbar (same color); once scrolled, a hairline fades in.
// The flag is on <html>: the section tabs (phones) draw the line instead.
const sentinel = document.querySelector(".top-sentinel");
if (sentinel) {
  new IntersectionObserver(([entry]) => {
    document.documentElement.toggleAttribute("data-scrolled", !entry?.isIntersecting);
  }).observe(sentinel);
}
</script>

<style>
.top-sentinel {
  position: absolute;
  top: 0;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

/* The height is fixed (--header, the notch's inset included); the hairline
   is drawn inside it, so it never shifts the page. */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  height: var(--header);
  padding-top: env(safe-area-inset-top, 0px);
  background: var(--bg);
  box-shadow: inset 0 -1px transparent;
  transition: box-shadow var(--slow) var(--ease);
}

:global(:root[data-scrolled]) .site-header {
  box-shadow: inset 0 -1px var(--line);
}

/* phones, under the section tabs: the bars read as one, the line goes under
   the tabs only (Tabs.astro) */
@media (max-width: 40rem) {
  :global(:root[data-scrolled] body:has(.tabs)) .site-header {
    box-shadow: inset 0 -1px transparent;
  }
}

.bar {
  display: flex;
  align-items: center;
  gap: 0.75rem 1.5rem;
  height: 100%;
}

.brand {
  display: block;
  text-decoration: none;
  margin-right: auto;
}

.tools {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
</style>
