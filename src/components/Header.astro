// SPDX-License-Identifier: Apache-2.0

// Top bar: logo · GitHub · theme.
import { githubMark } from "../lib/code";
import { site } from "../site.config";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="wrap bar">
    <a href={site.links.home} class="brand" aria-label={site.ui.homeLabel}>
      <Logo height={26} />
    </a>

    <div class="tools">
      {/* biome-ignore lint/a11y/useAnchorContent: aria-label names the link, the icon is hidden */}
      <a href={site.links.github} class="icon" aria-label={site.ui.githubLabel}>
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d={githubMark} />
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
  border-bottom: 1px solid var(--line);
}

.bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1.5rem;
  min-height: 3.75rem;
  padding-block: 0.6rem;
}

.brand {
  display: block;
  text-decoration: none;
  margin-right: auto;
}

.tools {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.icon {
  display: inline-grid;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: var(--radius-sm);
  color: var(--text);
}

.icon:hover {
  background: var(--fill);
}
</style>
