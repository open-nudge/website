---
// SPDX-FileCopyrightText: © 2026 open-nudge <https://github.com/open-nudge>
// SPDX-License-Identifier: Apache-2.0

// A project card. The install command is a bar along the bottom edge, with
// a uv / pip switch above it; one click switches the commands on every card.
// Each link carries a small icon of where it goes: GitHub, PyPI, docs.
import { githubMark, iconAttributes } from "../lib/code";
import type { Project } from "../lib/projects";
import { site } from "../site.config";
import Markdown from "./Markdown.astro";
import Switch from "./Switch.astro";
import Terminal from "./Terminal.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;

/** Stroke icons (16x16): an open book, the PyPI cube. */
const icons = {
  docs: [
    "M2.25 3h3.5A2.25 2.25 0 0 1 8 5.25v8.5a1.5 1.5 0 0 0-1.5-1.5H2.25z",
    "M13.75 3h-3.5A2.25 2.25 0 0 0 8 5.25v8.5a1.5 1.5 0 0 1 1.5-1.5h4.25z",
  ],
  pypi: ["M8 1.75 13.75 4.75v6.5L8 14.25l-5.75-3v-6.5z", "m2.25 4.75 5.75 3 5.75-3", "M8 7.75v6.5"],
};
---

<article class="card nudge" id={project.name}>
  <div class="body">
    <h3><a href={project.repo}>{project.name}</a></h3>
    <Markdown class="description" text={project.description} />
    {project.tags.length > 0 && (
      <ul class="tags" aria-label={site.ui.tags}>
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
    <div class="meta">
      <p class="links">
        <a href={project.repo}>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path fill="currentColor" d={githubMark} />
          </svg>{site.ui.github}
        </a>
        {project.pypi && (
          <a href={project.pypi}>
            <svg {...iconAttributes()}>
              {icons.pypi.map((d) => (
                <path d={d} />
              ))}
            </svg>
            {site.ui.pypi}
          </a>
        )}
        <a href={project.docs}>
          <svg {...iconAttributes()}>{icons.docs.map((d) => <path d={d} />)}</svg>{site.ui.docs}
        </a>
      </p>
      {project.commands && (
        <Switch
          name="installer"
          label={site.ui.installWith}
          options={[
            { value: "uv", label: site.ui.uv },
            { value: "pip", label: site.ui.pip },
          ]}
        />
      )}
    </div>
  </div>
  {project.commands && (
    <div class="install">
      <Terminal command={project.commands} switch="installer" />
    </div>
  )}
</article>

<style>
.body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1.15rem 1.25rem 0.9rem;
}

h3 {
  margin: 0;
}

/* the underline fades in rather than appearing */
h3 a {
  text-decoration-color: transparent;
}

h3 a:hover {
  text-decoration-color: currentColor;
}

:global(.description) {
  flex: 1;
  margin: 0;
  color: var(--muted);
  font-size: 0.95rem;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem 1rem;
  margin-top: 0.15rem;
}

.links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1rem;
  margin: 0;
  font-size: 0.85rem;
}

/* icon + label; only the label is underlined */
.links a {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.links svg {
  flex: none;
  color: var(--muted);
  transition: color var(--slow) var(--ease);
}

.links a:hover svg {
  color: var(--text);
  transition-duration: var(--fast);
}

/* fingers need taller targets than the pointer: same look, more padding */
@media (pointer: coarse) {
  .links a {
    padding-block: 0.3rem;
  }
}

/* the command: a bar across the bottom edge of the card, the card's own
     surface below a divider */
.install :global(.terminal) {
  border-top: 1px solid var(--divider);
  border-radius: 0 0 var(--radius) var(--radius);
  box-shadow: none;
}

.install :global(.terminal > code) {
  font-size: 0.84rem;
}

/* phones: GitHub's mobile sizes (global.css) */
@media (max-width: 40rem) {
  .links {
    font-size: 0.875rem;
  }

  .install :global(.terminal > code) {
    font-size: 0.8125rem;
  }
}
</style>
