{
  "name": "opennudge-website",
  "version": "0.0.0",
  "private": true,
  "description": "opennudge.com: static website built with Astro",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file=astro.env node_modules/astro/bin/astro.mjs dev",
    "build": "npm run check:content && node --env-file=astro.env node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file=astro.env node_modules/astro/bin/astro.mjs preview",
    "check": "npm run check:content && node --env-file=astro.env node_modules/astro/bin/astro.mjs check",
    "astro": "node --env-file=astro.env node_modules/astro/bin/astro.mjs",
    "setup": "npm ci && prek install",
    "fix": "prek run --all-files",
    "fix:js": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true",
    "check:js": "biome check --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true",
    "check:audit": "npm audit && npm audit signatures",
    "check:licenses": "node .github/tools/licenses.ts",
    "update:hooks": "prek update",
    "check:content": "node --experimental-strip-types --input-type=module -e \"import './scripts/check-content.ts'\"",
    "test": "node --experimental-strip-types --input-type=module -e \"import './scripts/content.test.ts'\""
  },
  "dependencies": {
    "@shikijs/themes": "4.5.0",
    "astro": "7.3.5",
    "marked": "18.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@j178/prek": "0.5.9",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
